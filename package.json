{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run host",
    "build": "ng build",
    "build:prod": "ng build --base-href /anaghasafer/dist/frontend/browser/ --configuration production && git add . && git commit -m \"Auto commit\" && git push",

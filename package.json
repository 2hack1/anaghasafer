    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2000.0",
    "@angular-devkit/build-angular": "^20.3.6",
    "@angular-devkit/core": "^20.3.6",
